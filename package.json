{
  "name": "lol-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n redis,proxy,desktop -c red,blue,green \"npm run redis\" \"npm run dev -w @lol/proxy\" \"npm run dev -w @lol/desktop\"",
    "dev:web": "concurrently -k -n redis,proxy,web -c red,blue,magenta \"npm run redis\" \"npm run dev -w @lol/proxy\" \"npm run dev -w @lol/web\"",
    "dist:desktop": "npm run dist -w @lol/desktop",
    "redis": "wsl -e docker start -a lol-redis",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=20"
  }
}
