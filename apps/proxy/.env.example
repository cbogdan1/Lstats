# Riot dev key from https://developer.riotgames.com (expires every 24h). Never commit .env.
RIOT_API_KEY=
REDIS_URL=redis://localhost:6379
PORT=3001
# Platform routing (SUMMONER-V4, LEAGUE-V4, CHAMPION-MASTERY-V4): eun1, euw1, na1, kr, ...
RIOT_PLATFORM=eun1
# Regional routing (ACCOUNT-V1, MATCH-V5): europe, americas, asia, sea
RIOT_REGION=europe
